      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L1">- Synced by music</text>
            <text for="L2">You're probably freaking out.</text>
            <text for="L3">Girls from school are waiting for me at recess,</text>
            <text for="L4">cutting their wrists in the toilet.</text>
            <text for="L5">Are the stars to blame or are the genes to blame?</text>
            <text for="L6">But honestly, I don't give a damn -</text>
            <text for="L7">- I’m not their mother.</text>
            <text for="L8">Russia is for the sad</text>
            <text for="L9">but I'm sad to die.</text>
            <text for="L10">And I'll finish smoking LD</text>
            <text for="L11">I'll make the bed.</text>
            <text for="L12">Tomorrow will be better</text>
            <text for="L13">but I'm too lazy to even get up.</text>
            <text for="L14">I, we, you -</text>
            <text for="L15">- children of that country,</text>
            <text for="L16">where flowers don't bloom,</text>
            <text for="L17">and we are going from the other side...</text>
            <text for="L18">we, you and I will be glad -</text>
            <text for="L19">- instead of fresh buttercups</text>
            <text for="L20">we pick up the car...</text>
            <text for="L21">..you, you -</text>
            <text for="L22">- children of that country,</text>
            <text for="L23">where flowers don't bloom,</text>
            <text for="L24">and we are going from the other side...</text>
            <text for="L25">we, you and I will be glad -</text>
            <text for="L26">- instead of fresh buttercups</text>
            <text for="L27">we pick up the car...</text>
            <text for="L28">..you, we - <span ttm:role="x-bg">..you, we -</span></text>
            <text for="L29">- children of that country, <span ttm:role="x-bg">- children of that country,</span></text>
            <text for="L30">where flowers don't bloom, <span ttm:role="x-bg">where flowers don't bloom,</span></text>
            <text for="L31">and we are going from the other side... <span ttm:role="x-bg">and we are going from the other side...</span></text>
            <text for="L32">we, you and I will be glad - <span ttm:role="x-bg">I, we, and I will be glad -</span></text>
            <text for="L33">- instead of fresh buttercups <span ttm:role="x-bg">- instead of fresh buttercups</span></text>
            <text for="L34">we take the automaat into our hands... <span ttm:role="x-bg">we take the automaat into our hands...</span></text>
          </translation>
        </translations>
