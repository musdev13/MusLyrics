      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L2">I had a dream</text>
            <text for="L3">in which my fears sang with me in unison.</text>
            <text for="L4">This is rare - one chance in a million.</text>
            <text for="L5">I am a warrior without armor.</text>
            <text for="L6">I am killed and conquered.</text>
            <text for="L7">oh-oh, oh-oh</text>
            <text for="L8">I had a dream.</text>
            <text for="L9">I saw how the sword offended us.</text>
            <text for="L10">I had a dream. I saw them.</text>
            <text for="L11">I had a dream.</text>
            <text for="L12">I saw how the sword offended us.</text>
            <text for="L13">I had a dream. I saw them.</text>
            <text for="L14">Hands shackled,</text>
            <text for="L15">oval shaped eyes.</text>
            <text for="L16">My friend death missed me for a long time.</text>
            <text for="L17">I take the gun out of the closet.</text>
            <text for="L18">She walks around the apartment.</text>
            <text for="L19">I take out the box of shot that was on the vinyl.</text>
            <text for="L20">Headshot -</text>
            <text for="L21">- Tin, shot on the floor.</text>
            <text for="L22">I felt cold because</text>
            <text for="L23">lost the game.</text>
            <text for="L24">And in the mirror, alas, there is no one</text>
            <text for="L25">I can't even see my face</text>
            <text for="L26">my...</text>
            <text for="L27">I haven't had a dream for four days,</text>
            <text for="L28">and all because of you.</text>
            <text for="L29">Insomnia has brought me down</text>
            <text for="L30">crazy. And I'm trying</text>
            <text for="L31">to come to my senses again.</text>
            <text for="L32">You cry, I dance.</text>
            <text for="L33">It's dancing on bones</text>
            <text for="L34">like visiting!</text>
            <text for="L35">I had a dream</text>
            <text for="L36">in which my fears sang with me in unison.</text>
            <text for="L37">This is rare - one chance in a million.</text>
            <text for="L38">I am a warrior without armor.</text>
            <text for="L39">I am killed and conquered.</text>
            <text for="L40">oh-oh, oh-oh</text>
          </translation>
        </translations>
