        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L1">- Synced by music</text>
            <text for="L2">While I play these songs by the fire,</text>
            <text for="L3">eyes are watching us from the forest.</text>
            <text for="L4">They're watching us from under the bridge.</text>
            <text for="L5">And in the moments of the end you are one hundred out of a hundred.</text>
            <text for="L6">Ooh</text>
            <text for="L7">I'll see you on the other side.</text>
            <text for="L8">Come closer, I'll hug you.</text>
            <text for="L9">Together you and I will go down.</text>
            <text for="L10">You and I will go down again.</text>
          </translation>
        </translations>
