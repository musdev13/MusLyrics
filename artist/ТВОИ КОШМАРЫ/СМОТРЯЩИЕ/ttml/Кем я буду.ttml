        <ttm:name>Lead</ttm:name>
      </ttm:agent>
      <composer:groups>
        <composer:group id="g1" label="Group 1" color="#f472b6" templateVersion="1" sharesTiming="true"/>
      </composer:groups>
      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L1">- Synced by music</text>
            <text for="L2">Tablecloth and on the floor.</text>
            <text for="L3">You didn't get the joke.</text>
            <text for="L4">It seems I got it.</text>
            <text for="L5">The knife stuck in like an injection.</text>
            <text for="L6">How can I escape</text>
            <text for="L7">from you to others, to freedom?</text>
            <text for="L8">How hard it is to breathe</text>
            <text for="L9">if I argue with you.</text>
            <text for="L10">Who will I be if I am</text>
            <text for="L11">is it too late to come?</text>
            <text for="L12">Who will I be if I am</text>
            <text for="L13">Don't like the smell?</text>
            <text for="L14">From your perfume, everywhere,</text>
            <text for="L15">I can't breathe.</text>
            <text for="L16">Who will I be if more</text>
            <text for="L17">I won't decide?</text>
            <text for="L18">You're confusing it with a dog, even though it's a purebred animal.</text>
            <text for="L19">Forgive me, however,</text>
            <text for="L20">what should we do now?</text>
            <text for="L21">Tablecloth and on the floor.</text>
            <text for="L22">You didn't get the joke.</text>
            <text for="L23">It seems I got it.</text>
            <text for="L24">The knife stuck in like an injection.</text>
            <text for="L25">How can I escape</text>
            <text for="L26">from you to others, to freedom?</text>
            <text for="L27">How hard it is to breathe</text>
            <text for="L28">if I argue with you.</text>
            <text for="L29">Me and you</text>
            <text for="L30">you and me.</text>
            <text for="L31">How unexpected</text>
            <text for="L32">love has come</text>
            <text for="L33">and disrupted sleep patterns.</text>
            <text for="L34">Well then,</text>
            <text for="L35">and then there will be nights without sleep.</text>
            <text for="L36">Even shorter than love</text>
            <text for="L37">shorter than spring.</text>
            <text for="L38">Tablecloth and on the floor.</text>
            <text for="L39">You didn't get the joke.</text>
            <text for="L40">It seems I got it.</text>
            <text for="L41">The knife stuck in like an injection.</text>
            <text for="L42">How can I escape</text>
            <text for="L43">from you to others, to freedom?</text>
            <text for="L44">How hard it is to breathe</text>
            <text for="L45">if I argue with you.</text>
          </translation>
        </translations>
