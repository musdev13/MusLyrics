        <composer:group id="g1" label="Group 1" color="#f472b6" templateVersion="1" sharesTiming="true"/>
        <composer:group id="g2" label="Group 2" color="#60a5fa" templateVersion="1" sharesTiming="true"/>
      </composer:groups>
      <iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal">
        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L1">- Synced by music</text>
            <text for="L2">I think again:</text>
            <text for="L3">"Where should I look for you?" -</text>
            <text for="L4">when you are not in my house again.</text>
            <text for="L5">I'm going out for a walk</text>
            <text for="L6">only at night.</text>
            <text for="L7">After all, the rest are just a haze in the background.</text>
            <text for="L8">Haze in the background.</text>
            <text for="L9">Hide, love, I'll put the songs in the background.</text>
            <text for="L10">Sad, like you loved in the old album</text>
            <text for="L11">The radio is spinning. You were in a lot of pain</text>
            <text for="L12">but now that's enough.</text>
            <text for="L13">Be patient and wait</text>
            <text for="L14">when we will be saved.</text>
            <text for="L15">And think that everything is around</text>
            <text for="L16">they are waiting for you and me.</text>
            <text for="L17">They are waiting, waiting.</text>
            <text for="L18">They are waiting for you and me.</text>
            <text for="L19">Here, here.</text>
            <text for="L20">They are waiting for you and me.</text>
            <text for="L21">They are waiting, waiting.</text>
            <text for="L22">I’ll go and surrender to them, and for now you sit here, here.</text>
            <text for="L23">One, two, three.</text>
            <text for="L24">I am water, you run while I count to five.</text>
            <text for="L25">Look, half of the summer is behind us, August is still ahead.</text>
            <text for="L26">Don't be angry, I'll wait at home. I'll make tea when I arrive</text>
            <text for="L27">Where are you?</text>
            <text for="L28">You can't be seen.</text>
            <text for="L29">And the haze began to appear near the house again.</text>
            <text for="L30">Haze in the background.</text>
            <text for="L31">Hide, love, I'll put the songs in the background.</text>
            <text for="L32">Sad, like you loved in the old album</text>
            <text for="L33">The radio is spinning. You were in a lot of pain</text>
            <text for="L34">but now that's enough.</text>
            <text for="L35">Haze, haze.</text>
            <text for="L36">Haze, haze.</text>
          </translation>
        </translations>
