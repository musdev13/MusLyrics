      <composer:groups>
        <composer:group id="g1" label="Group 1" color="#f472b6" templateVersion="1" sharesTiming="true" ownTimingInstances="1"/>
        <composer:group id="g2" label="Group 2" color="#60a5fa" templateVersion="1" sharesTiming="true"/>
