        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L1">- Synced by music</text>
            <text for="L2">Video boutique.</text>
            <text for="L3">Let's go with you through the courtyards,</text>
            <text for="L4">and there is a dead end.</text>
            <text for="L5">Let's take a detour with you.</text>
            <text for="L6">I've been waiting for this damn day for a whole year.</text>
            <text for="L7">My head is a mess.</text>
            <text for="L8">Hidden in my pocket is a mobile phone and a tick-tock.</text>
            <text for="L9">And it seems it's time for you to go home,</text>
            <text for="L10">and I'm going with you again.</text>
            <text for="L11">I'll throw all the tapes out the window.</text>
            <text for="L12">Among the color, I am an ordinary spot.</text>
            <text for="L13">But when I'm with her</text>
            <text for="L14">my face turns red and I feel so good</text>
            <text for="L15">Video boutique.</text>
            <text for="L16">Let's go with you through the courtyards,</text>
            <text for="L17">and there is a dead end.</text>
            <text for="L18">Let's take a detour with you.</text>
            <text for="L19">I've been waiting for this damn day for a whole year.</text>
            <text for="L20">My head is a mess.</text>
            <text for="L21">Hidden in my pocket is a mobile phone and a tick-tock.</text>
            <text for="L22">And it seems it's time for you to go home,</text>
            <text for="L23">and I'm going with you again.</text>
            <text for="L24">Let's take a camera and lens.</text>
            <text for="L25">Afterwards, I’ll invite you for an aperitif.</text>
            <text for="L26">And you agreed immediately.</text>
            <text for="L27">The most evil plan</text>
            <text for="L28">to invite you to...</text>
            <text for="L29">Video boutique.</text>
            <text for="L30">Let's go with you through the courtyards,</text>
            <text for="L31">and there is a dead end.</text>
            <text for="L32">Let's take a detour with you.</text>
            <text for="L33">I've been waiting for this damn day for a whole year.</text>
            <text for="L34">My head is a mess.</text>
            <text for="L35">Hidden in my pocket is a mobile phone and a tick-tock.</text>
            <text for="L36">And it seems it's time for you to go home,</text>
            <text for="L37">and I'm going with you again.</text>
          </translation>
        </translations>
