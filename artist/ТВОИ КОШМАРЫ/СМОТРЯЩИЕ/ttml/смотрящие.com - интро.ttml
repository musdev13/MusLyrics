        <translations>
          <translation xml:lang="en" type="subtitle">
            <text for="L2">The connection has been established.</text>
            <text for="L3">The notification is activated.</text>
            <text for="L4">The program "watchers" is a laboratory monitoring module</text>
            <text for="L5">and analytics of human desires.</text>
            <text for="L6">The system records, classifies and evaluates the parameters of desires,</text>
            <text for="L7">in accordance with internal metrics.</text>
            <text for="L8">By clicking on the button, you automatically signed consent to listen</text>
            <text for="L9">of this audio material</text>
            <text for="L11">*knock* *knock* *knock*</text>
          </translation>
        </translations>
